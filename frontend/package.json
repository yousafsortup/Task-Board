{
  "name": "taskboard",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform Task Board — one React Native codebase running on iOS, Android, and the desktop.",
  "main": "electron/main.js",
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "ios:pods": "cd ios && bundle exec pod install",
    "android": "react-native run-android --port 8083",
    "web": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "desktop": "concurrently --kill-others --names \"vite,electron\" --prefix-colors \"magenta,cyan\" \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "desktop:build": "npm run web:build && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "dev.taskboard.desktop",
    "productName": "Task Board",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "@noble/hashes": "^1.8.0"
  },
  "author": "Yousaf",
  "license": "MIT"
}
